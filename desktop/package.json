{
  "name": "pchelper-desktop",
  "version": "1.1.0",
  "private": true,
  "description": "PCHelper — desktop-клиент интернет-магазина комплектующих",
  "author": "Алексей Наркевич",
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "generate:icon": "node -e \"const mod=require('png-to-ico');const pngToIco=mod.default||mod;const fs=require('fs');(async()=>{const buf=await pngToIco('logo.png');fs.writeFileSync('icon.ico',buf);})();\"",
    "prebuild:win": "npm run generate:icon",
    "build:win": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^35.7.5",
    "electron-builder": "^24.13.3",
    "png-to-ico": "^3.0.1"
  },
  "build": {
    "appId": "com.pchelper.store",
    "productName": "PCHelper",
    "artifactName": "PCHelper-Portable-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "splash.html",
      "logo.png",
      "icon.ico",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!tests/**",
          "!coverage/**",
          "!*.log"
        ]
      },
      {
        "from": "../frontend/dist",
        "to": "frontend/dist",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "icon.ico",
      "signAndEditExecutable": false,
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "PCHelper-Portable-${version}-${arch}.${ext}"
    }
  }
}
